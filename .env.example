# ============================================================
# QVC Super App – Environment Variables
# Copy file này thành .env và điền giá trị thật
# ============================================================

# URL Backend Laravel (BẮTBUỘC)
EXPO_PUBLIC_API_URL=https://crm.maytinhquocviet.com/api

# URL CRM WebView (BẮTBUỘC)
EXPO_PUBLIC_CRM_URL=https://crm.maytinhquocviet.com

# Timeout request (ms)
EXPO_PUBLIC_API_TIMEOUT=30000

# App version (đồng bộ với app.json)
EXPO_PUBLIC_APP_VERSION=1.0.0

# Môi trường (development | production)
EXPO_PUBLIC_ENV=development

# Sentry DSN để tracking crash (để trống nếu chưa dùng)
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps API Key (để trống nếu chưa dùng)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
